import "CommonBots"
import "../Effects/CommonEffects"

FACTION_PARAMS = [
  sanghoy: [
    miner: "thrall",
    builders: ["thrall"],
    minerProducer: "sanghoyCamp",
    buildMinerProducerSkill: "buildSanghoyCamp",
    minerProduceSkill: "trainThrall",
    collectGoldConsiderations: [
        [condition: => Game.currentPlayer.resources.g < 10, score: 0.4],
        [condition: => Game.currentPlayer.resources.g < 20, score: 0.4],
        [condition: => Game.currentPlayer.resources.g > 20, score: 0.3]
    ],
    builderProducer: "sanghoyCamp",
    builderProduceSkill: "trainThrall",
    heroProducer: "runestoneOfRogash",
    buildHeroProducerSkill: "buildRunestoneOfRogash",
    heroProduceSkills: ["trainKagaalu", "trainPyracmon", "trainMaim"],
    minorUpgradeProducers: ["warCouncil", "totem"],
    majorUpgradeProducers: ["sanghoyCamp"],
    unitProducers: [sanghoyCamp: 0.2, warCouncil: 0.45, totem: 0.35],
    buildUnitProducerSkills: [sanghoyCamp: "buildSanghoyCamp", warCouncil: "buildWarCouncil", totem: "buildTotem"],
    trainUnitSkills: [
      sanghoyCamp: [
        trainWarrior: ["warrior", 10]
      ],
      warCouncil: [
        trainShadespear: ["shadespear", 10],
        trainRaider: ["raider", 10],
        trainMantlet: ["mantlet", 3],
        trainBloodProwler: ["bloodProwler", 10]
      ],
      totem: [
        trainSarcomancer: ["sarcomancer", 3],
        trainShaper: ["shaper", 3]
      ]
    ],
    nonHeroCasters: ["shaper", "sarcomancer", "raider", "thrall", "sacrificialWell", "totem"],
    spells: ["bloodlust", "sanghoyHorde", "karrish", "bloodToRogash", "horribleMisshaping"]
  ],
  frenza: [
    miner: "settler",
    builders: ["settler", "colonialHall"],
    minerProducer: "colonialHall",
    buildMinerProducerSkill: "foundColony",
    minerProduceSkill: "trainSettler",
    collectGoldConsiderations: [
        [condition: => Game.currentPlayer.resources.g < 10, score: 0.4],
        [condition: => Game.currentPlayer.resources.g < 20, score: 0.3],
        [condition: => Game.currentPlayer.resources.g < 30, score: 0.2],
        [condition: => Game.currentPlayer.resources.g > 30, score: 0.3]
    ],
    builderProducer: "settler",
    builderProduceSkill: "foundColony",
    heroProducer: "magistratesCourt",
    buildHeroProducerSkill: "buildMagistratesCourt",
    heroProduceSkills: [#*"trainVitarron",*# "trainTofan", "trainDenburhin"],
    minorUpgradeProducers: ["factory", "barracks"],
    majorUpgradeProducers: ["colonialHall"],
    unitProducers: [barracks: 0.25, factory: 0.375, airfield: 0.375],
    buildUnitProducerSkills: [barracks: "buildBarracks", factory: "buildFactory", airfield: "buildAirfield"],
    trainUnitSkills: [
      barracks: [
        trainRifleman: ["rifleman", 10], # was "trainRiflman", so riflemen were never trained
        trainAssassin: ["assassin", 3]
      ],
      factory: [
        trainSteamGolem: ["steamGolem", 5],
        trainDevilhornTank: ["devilhornTank", 5],
        trainMEV: ["mev", 1],
        trainAutoturret: ["autoturret", 2] # was "traiAutoturret"
      ],
      airfield: [
        trainAssaultAirship: ["assaultAirship", 5],
        trainCargoDirigible: ["cargoDirigible", 1]
      ]
    ],
    nonHeroCasters: ["settler", "rifleman", "assassin", "dragoon", "steamGolem", "devilhornTank", "voltTank", "mev", "assaultAirship",
      "colonialHall", "airfield", "magistratesCourt"],
    spells: ["valiantPromotion", "paradrop", "endlessExpansionShipment", "airSuperiorityShipment", "eradicateThePestShipment",
      "emperorsFistShipment", "theNextGenerationShipment", "hardenedVeteransShipment", "theCulling", "scrapyardColossusShipment"]
  ]
]

# spells any faction can get by interacting with neutral map objects
NEUTRAL_SPELLS = ["mercilessAssassination"]

ADD_MAJOR_UPGRADE = "addMajorUpgrade"
ADD_MINOR_UPGRADE = "addMinorUpgrade"

MAX_SKILL_CASTERS_TO_ANALYZE = 5
MAX_STANCE_CHANGES_TO_ANALYZE = 4
MAX_INTERACTORS_TO_ANALYZE = 2
MAX_ATTACKERS_TO_ANALYZE = 10
MAX_MOVERS_TO_ANALYZE = 6
WOUNDED_RATIO = 0.35 # below this share of health, units in danger pull back
HOME_RADIUS = 3 # the army gathers within this many cells of its base

# Naming note: inside a bot class, an identifier that matches one of its methods means `this.method`,
# even for local variables. So locals here never reuse method names (attack, advance, retreat...).
ai MeleeAi is ValueAi {
  approachScoreForEnemy => 0.58
  approachScoreForCreep => 0.52

  # Difficulty knobs, overridden by the tiers at the end of the file.
  # Avoid cells enemies can reach and pull wounded units back.
  usesThreatMap => true
  # Coordinate attacks within a turn: focus fire, and let tough units soak up retaliation first.
  plansAttacks => false
  # How much stronger the army must be than the enemies around its objective before it advances.
  # 0 attacks with whatever is available, one unit at a time.
  advanceRatio => 1.3
  minArmySize => 3

  awake {
    super.awake()
    @rememberEnemies(Game.currentPlayer)
  }

  # Bots only see what's not under fog of war. They remember enemy buildings they've seen, so they know
  # where to attack when the enemy is out of sight.
  rememberEnemies(player) {
    if this::enemyBuildings == null {
      @enemyBuildings = [:]
    }
    for cell in Game.grid.visibleCells(player) {
      key = coordinatesKey(cell.coordinates)
      content = cell.content
      if content != null && content.owner.id != Game.nature.id && !player.isAllyOf(content) && content.isBuilding {
        @enemyBuildings.(key) = cell.coordinates
      } else if @enemyBuildings.(key) != null {
        @enemyBuildings.(key) = null # gone (destroyed or never there)
      }
    }
  }

  computeActions => @commonActions(FACTION_PARAMS.(Game.currentPlayer.faction))

  commonActions(params) {
    player = Game.currentPlayer
    playableCards = player.hand.where(=> $0.downtime == 0)
    playableUnits = playableCards.where( => $0.type.type == "unit")
    visibleCells = Game.grid.visibleCells(player)
    influencedCells = visibleCells.where(=> $0.influencer == player.id)
    emptyInfluencedCells = influencedCells.where(=> $0.content == null)
    knownGoldSources = visibleCells.where(fn (cell) => cell.content?.extras?.first(=> $0.id == "mineableGold")?.value ?? 0 > 0)

    miners = player.ownedUnits.where(=> $0.type.id == params.miner)
    minersThatCanMove = miners.where(=> !$0.movementRange.isEmpty)
    minersAtGoldSource = miners.where(fn (miner) => knownGoldSources.any(fn (source) => source.distance(miner.coordinates) == 1))
    minerProducers = player.ownedUnits.where(=> $0.type.id == params.minerProducer)

    builders = player.ownedUnits.where(=> $0.type.id in params.builders)
    buildersWithAp = builders.where(=> $0.ap > 0)

    heroProducer = player.ownedUnits.first(=> $0.type.id == params.heroProducer)
    heroProducerCard = player.hand.first(=> $0.type.id == params.heroProducer)
    hero = player.hero

    unitProducers = player.ownedUnits.where(=> $0.type.id in params.unitProducers.keys)

    army = player.ownedUnits.where(=> $0.type.a > 0 && !$0.isBuilding)
    soldiers = army.where(=> $0.ap > 0)
    creeps = visibleCells.where(=> $0.content != null && $0.content.owner.id == Game.nature.id \
      && $0.content.type.a > 0 && $0.content.type?.interactionEffect == null)
    enemies = visibleCells.where(=> $0.content != null && $0.content.owner.id != Game.nature.id && !player.isAllyOf($0.content))

    home = @homeOf(player, minerProducers)
    objective = @objectiveFor(player, home, enemies)
    ready = @armyIsReady(army, objective, home, enemies)

    return [
      @collectGold(minersAtGoldSource, knownGoldSources, params.collectGoldConsiderations),
      @buildMinerProducer(builders, minerProducers, params.buildMinerProducerSkill),
      @buildMiner(miners, minerProducers, params.miner, params.minerProduceSkill),
      @moveToGold(miners, minersThatCanMove, knownGoldSources),

      @researchUpgrade(params.majorUpgradeProducers, params.minorUpgradeProducers),
      @playUpgrade(playableCards),

      @buildHeroProducer(hero, heroProducer, heroProducerCard, buildersWithAp, params.buildHeroProducerSkill),
      @playHeroProducerCard(heroProducerCard, emptyInfluencedCells),
      @trainHero(hero, heroProducer, params.heroProduceSkills.randomItem),
      @reviveHero(hero, heroProducer),
      @playReviveCard(playableCards, emptyInfluencedCells, home),
      @upgradeHero(hero, playableCards),

      @buildUnitProducer(builders, unitProducers, params.unitProducers, params.buildUnitProducerSkills),
      @trainUnit(unitProducers, params.trainUnitSkills, hero, heroProducer),
      @playUnit(playableUnits, emptyInfluencedCells, knownGoldSources, params, objective),
      @makeRoom(player, playableUnits, emptyInfluencedCells, objective ?? home),

      @explore(player),
      @attack(hero, soldiers, enemies, false, 0.6, "enemy"),
      @attack(hero, soldiers, creeps, true, 0.5, "creep"),
      @advance(player, soldiers, objective, home, ready),
      @approachCreeps(hero, soldiers, creeps),
      @retreat(player, soldiers, home),
      @castSkill(player, params.nonHeroCasters),
      @castSpell(player, playableCards, params.spells, enemies, objective ?? home),
      @changeStance(hero, soldiers, enemies),
      @interact(player),

      @concede(player, playableCards, miners, hero, heroProducer, unitProducers, soldiers)
    ]
  }

  # The bot's base: its main building, else its hero, else any unit.
  homeOf(player, minerProducers) {
    # (`first(=> true)` wouldn't do: a lambda's parameters are the $N names it uses, so that one takes none)
    building = if minerProducers.isEmpty player.ownedUnits.first(=> $0.isBuilding) else minerProducers.0
    if building != null {
      return building.coordinates
    }
    anyUnit = player.ownedUnits.first(=> $0.coordinates != null)
    return anyUnit?.coordinates
  }

  # Where the army should go: the visible enemy closest to home, else the closest enemy building it
  # remembers, else the closest other starting location.
  objectiveFor(player, home, enemies) {
    if home == null {
      return null
    }
    if !enemies.isEmpty {
      return enemies.minBy(=> $0.distance(home)).coordinates
    }
    homeCell = Game.grid.elementAt(home)
    known = []
    for key in @enemyBuildings.keys {
      remembered = @enemyBuildings.(key)
      if remembered != null {
        known.add(remembered)
      }
    }
    if !known.isEmpty {
      return known.minBy(=> homeCell.distance($0))
    }
    others = Game.grid.startingLocations.where(=> homeCell.distance($0) > HOME_RADIUS)
    if others.isEmpty {
      return null
    }
    return others.minBy(=> homeCell.distance($0))
  }

  # Attack once the army clearly outmatches what it can see around the objective; always fight enemies
  # that come close to home.
  armyIsReady(army, objective, home, enemies) {
    if objective == null {
      return false
    }
    ratio = advanceRatio()
    if ratio <= 0 {
      return true
    }
    homeCell = Game.grid.elementAt(home)
    if homeCell.distance(objective) <= HOME_RADIUS + 3 {
      return true # defend
    }
    if army.size < minArmySize() {
      return false
    }
    ours = sum(army.map(=> combatStrength($0)))
    nearObjective = enemies.where(=> $0.distance(objective) <= 6)
    theirs = sum(nearObjective.map(=> combatStrength($0.content)))
    return ours >= theirs * ratio
  }

  collectGold(minersAtGoldSource, knownGoldSources, goldConsiderations) {
    if minersAtGoldSource.isEmpty {
      return REJECTED_ACTION
    }
    minersThatCanMine = minersAtGoldSource.where(=> $0.ap >= 2) # TODO change to read skill effect cost
    if minersThatCanMine.isEmpty {
      return REJECTED_ACTION
    }
    randomMiner = minersThatCanMine.randomItem
    adjacentMine = knownGoldSources.first(=> $0.distance(randomMiner.coordinates) == 1)
    return [
      key: "mine:$(randomMiner.id)",
      considerations: goldConsiderations,
      run: fn {
        Console.debug("Mining")
        Server.cast(randomMiner, adjacentMine.coordinates, "mineGold")
      }
    ]
  }

  buildMinerProducer(builders, minerProducers, skillId) {
    builder = builders.first(=> skillCanBeCast(Game.currentPlayer, $0, skillId))
    return if builder == null {
      REJECTED_ACTION
    } else {
      [
        considerations: [
          [condition: true, score: 1 - 0.9 * minerProducers.size]
        ],
        run: fn {
          Console.debug("Building miner producer")
          Server.cast(builder, null, skillId)
        }
      ]
    }
  }

  buildMiner(miners, minerProducers, minerId, skillId) {
    producer = minerProducers.first(=> skillCanBeCast(Game.currentPlayer, $0, skillId))
    if producer == null {
      return REJECTED_ACTION
    }
    minersCount = miners.size + Game.currentPlayer.hand.count(=> $0.type.id == minerId)
    return [
      considerations: [
        [condition: true, score: 1 - 0.2 * minersCount]
      ],
      run: fn {
        Console.debug("Training miner")
        Server.cast(producer, null, skillId)
      }
    ]
  }

  moveToGold(allMiners, minersThatCanMove, knownGoldSources) {
    if knownGoldSources.isEmpty || minersThatCanMove.isEmpty {
      return REJECTED_ACTION
    }
    minersNotAtGoldSource = minersThatCanMove.where(fn (miner) => !knownGoldSources.any(fn (source) => source.distance(miner.coordinates) == 1))
    if minersNotAtGoldSource.isEmpty {
      return REJECTED_ACTION
    }
    # only miners that aren't mining yet (it used to pick from all of them, pulling miners off their gold)
    miner = minersNotAtGoldSource.randomItem
    minerLocation = miner.coordinates
    nearestGold = knownGoldSources.minBy(=> $0.distance(minerLocation)).coordinates
    step = miner.approach(nearestGold, 1) # along a real path, around water and mountains
    target = null
    cost = 0
    if step != null {
      target = step.coordinates
      cost = step.movementCost
    } else {
      target = miner.movementRange.minBy(=> $0.distance(nearestGold)).coordinates
      cost = miner.movementCost(target)
    }
    return [
      key: "move:$(miner.id)",
      considerations: [
        [condition: Game.currentPlayer.resources.g < 10, score: 0.6],
        [condition: Game.currentPlayer.resources.g < 20, score: 0.3],
        [condition: Game.currentPlayer.resources.g > 20, score: 0.1],
        [condition: true, score: -0.2 * (allMiners.size - minersNotAtGoldSource.size)]
      ],
      run: fn {
        Console.debug("Moving towards mine")
        Server.move(minerLocation, target, cost)
      }
    ]
  }

  # Only researches upgrades that have a free slot in the tree; extra ones used to sit in the hand forever,
  # taking the place of unit cards.
  researchUpgrade(majorProducerIds, minorProducerIds) {
    units = Game.currentPlayer.ownedUnits
    tree = Game.currentPlayer.upgradeTree
    majorSlots = tree.emptyNodesForKind("major").size - Game.currentPlayer.hand.count(=> $0.type::kind == "major")
    minorSlots = tree.emptyNodesForKind("minor").size - Game.currentPlayer.hand.count(=> $0.type::kind == "minor")
    majorUpgradeProducer = if majorSlots <= 0 null else \
      units.first(=> $0.type.id in majorProducerIds && skillCanBeCast(Game.currentPlayer, $0, ADD_MAJOR_UPGRADE))
    if majorUpgradeProducer != null {
      return [
        considerations: [
          [condition: true, score: 0.7 - 0.2 * totalCountForUpgradeKind("major")]
        ],
        run: fn {
          Console.debug("Producing major upgrade")
          Server.cast(majorUpgradeProducer, null, ADD_MAJOR_UPGRADE)
        }
      ]
    } else {
      minorUpgradeProducer = if minorSlots <= 0 null else \
        units.first(=> $0.type.id in minorProducerIds && skillCanBeCast(Game.currentPlayer, $0, ADD_MINOR_UPGRADE))
      return if minorUpgradeProducer == null {
        REJECTED_ACTION
      } else {
        [
          considerations: [
            [condition: true, score: 0.66 - 0.1 * totalCountForUpgradeKind("minor")]
          ],
          run: fn {
            Console.debug("Producing minor upgrade")
            Server.cast(minorUpgradeProducer, null, ADD_MINOR_UPGRADE)
          }
        ]
      }
    }
  }

  playUpgrade(playableCards) {
    upgradeCard = null
    majorUpgrade = playableCards.first(=> $0.type.id == "majorUpgrade")
    if majorUpgrade != null {
      upgradeCard = majorUpgrade
    } else {
      minorUpgrade = playableCards.first(=> $0.type.id == "minorUpgrade")
      if minorUpgrade != null {
        upgradeCard = minorUpgrade
      } else {
        return REJECTED_ACTION
      }
    }
    availableNodes = Game.currentPlayer.upgradeTree.emptyNodesForKind(upgradeCard.type.kind)
    if availableNodes.isEmpty {
      return REJECTED_ACTION
    }
    # presently, just play to a random available slot
    node = availableNodes.randomItem
    return [
      key: "upgrade:$(node.id)",
      considerations: [
        [condition: true, score: 0.8]
      ],
      run: fn {
        Console.debug("Playing upgrade: $(node.type)")
        Server.play(upgradeCard, null, node.id)
      }
    ]
  }

  buildHeroProducer(hero, heroProducer, heroProducerCard, buildersWithAp, skillId) {
    if hero != null || heroProducer != null || heroProducerCard != null || buildersWithAp.isEmpty {
      return REJECTED_ACTION
    }
    builder = buildersWithAp.first(=> skillCanBeCast(Game.currentPlayer, $0, skillId))
    if builder == null {
      return REJECTED_ACTION
    }
    return [
      key: "buildHeroProducer",
      considerations: [
        [condition: true, score: 0.8]
      ],
      run: fn {
        Console.debug("Building hero producer")
        Server.cast(builder, null, skillId)
      }
    ]
  }

  playHeroProducerCard(heroProducerCard, emptyInfluencedCells) {
    if heroProducerCard == null || heroProducerCard.downtime > 0 || emptyInfluencedCells.isEmpty {
      return REJECTED_ACTION
    }
    randomCell = emptyInfluencedCells.randomItem
    return [
      key: "playHeroProducer",
      considerations: [
        [condition: true, score: 0.5]
      ],
      run: fn {
        Console.debug("Playing hero producer")
        Server.play(heroProducerCard, randomCell.coordinates, null)
      }
    ]
  }

  trainHero(hero, heroProducer, skillId) {
    if hero != null || heroProducer == null {
      return REJECTED_ACTION
    }
    if !skillCanBeCast(Game.currentPlayer, heroProducer, skillId) {
      return REJECTED_ACTION
    }
    return [
      key: "trainHero",
      considerations: [
        [condition: true, score: 0.78]
      ],
      run: fn {
        Console.debug("Training hero")
        Server.cast(heroProducer, null, skillId)
      }
    ]
  }

  # Two ways back for a fallen hero: "reviveHero" brings it back next turn on a free cell next to the
  # building, "addReviveHeroToHand" (pricier) adds a spell that can put it on any influenced cell.
  reviveHero(hero, heroProducer) {
    if hero == null || hero.isAlive || heroProducer == null {
      return REJECTED_ACTION
    }
    skillId = "reviveHero"
    # castTargets also runs the skill's own check (a free cell next to the building), which
    # skillCanBeCast doesn't; without it the bot retried a refused revive until it ran out of moves
    if !skillCanBeCast(Game.currentPlayer, heroProducer, skillId) \
        || Game.castTargets(heroProducer.coordinates, heroProducer, skillId).isEmpty {
      skillId = "addReviveHeroToHand"
      if !skillCanBeCast(Game.currentPlayer, heroProducer, skillId) {
        return REJECTED_ACTION
      }
    }
    return [
      key: "revive",
      considerations: [
        [condition: true, score: 0.7]
      ],
      run: fn {
        Console.debug("Reviving hero with $skillId")
        Server.cast(heroProducer, null, skillId)
      }
    ]
  }

  playReviveCard(playableCards, emptyInfluencedCells, home) {
    card = playableCards.first(=> $0.type.id == "reviveHeroToInfluencedCell")
    if card == null || emptyInfluencedCells.isEmpty {
      return REJECTED_ACTION
    }
    cell = if home == null emptyInfluencedCells.randomItem else emptyInfluencedCells.minBy(=> $0.distance(home))
    return [
      key: "playRevive",
      considerations: [
        [condition: true, score: 0.85]
      ],
      run: fn {
        Console.debug("Playing revive hero")
        Server.play(card, cell.coordinates, null)
      }
    ]
  }

  # The upgrade order comes from the hero's `ai: upgradePath:` in the faction data. Takes the first one
  # up to the hero's level that's still free, so a taken slot doesn't make the bot retry it every step.
  upgradeHero(hero, playableCards) {
    upgrade = playableCards.first(=> $0.type.id == "heroUpgrade")
    if hero == null || upgrade == null {
      return REJECTED_ACTION
    }
    path = hero.type?.aiHints?.upgradePath
    if path == null || path.isEmpty {
      return REJECTED_ACTION
    }
    nodes = hero.upgradeTree.allNodes
    nodeId = null
    upgradeType = null
    available = Math.min(hero.level, path.size)
    i = 0
    while i < available {
      candidate = path.(i)
      node = nodes.first(=> $0.type == candidate && $0.upgrade == null)
      if node != null {
        nodeId = node.id
        upgradeType = candidate
        break
      }
      i += 1
    }
    if nodeId == null {
      return REJECTED_ACTION
    }
    return [
      key: "heroUpgrade:$nodeId",
      considerations: [
        [condition: true, score: 0.8]
      ],
      run: fn {
        Console.debug("Playing hero upgrade: $upgradeType")
        Server.play(upgrade, null, nodeId)
      }
    ]
  }

  buildUnitProducer(builders, unitProducers, producerWeights, buildSkills) {
    # first, figure out which unit producer we're missing by examining weights
    producersWithCounts = producerWeights.keys.mapToObject(=> $0, fn (type) => totalCountForUnitType(type) * 1.0 / Math.max(unitProducers.size, 1))
    # highest weight first (the comparator's result used to be truncated to an int, so this didn't sort)
    sortedProducerWeightKeys = producerWeights.keys.sortedBy(=> producerWeights.($1) - producerWeights.($0))
    typeToProduce = null
    builder = null
    for producer in sortedProducerWeightKeys {
      candidateBuilder = builders.first(=> skillCanBeCast(Game.currentPlayer, $0, buildSkills.(producer)))
      if candidateBuilder == null {
        continue # if nobody can build it, skip
      }
      typeToProduce = producer
      builder = candidateBuilder
      if producersWithCounts.(producer) < producerWeights.(producer) {
        break # if there are fewer of this building than expected, select it
      }
    }
    if builder == null {
      return REJECTED_ACTION
    }
    buildScore = 0.7 - 0.33 * totalCountForUnitType(typeToProduce)
    return [
      considerations: [
        [condition: true, score: buildScore]
      ],
      run: fn {
        Console.debug("Building unit producer: $typeToProduce")
        Server.cast(builder, null, buildSkills.(typeToProduce))
      }
    ]
  }

  trainUnit(unitProducers, trainUnitSkills, hero, heroProducer) {
    availableProducers = []
    for producerType in trainUnitSkills.keys {
      producers = unitProducers.where(=> $0.type.id == producerType)
      skillsForProducerType = trainUnitSkills.(producerType)
      for skill in skillsForProducerType.keys {
        producersThatCanCast = producers.where(=> skillCanBeCast(Game.currentPlayer, $0, skill))
        if producersThatCanCast.isEmpty {
          continue
        }
        unitWithMaxCount = skillsForProducerType.(skill)
        unitThatSkillProduces = unitWithMaxCount.0
        maxCount = unitWithMaxCount.1
        unitCount = totalCountForUnitType(unitThatSkillProduces)
        factor = if (unitCount > maxCount) 300 else 50
        merit = Game.data.find(unitThatSkillProduces).merit - factor * unitCount
        availableProducers.addAll(producersThatCanCast.map(=> [producer: $0, skillId: skill, merit: merit]))
      }
    }
    if availableProducers.isEmpty {
      return REJECTED_ACTION
    }
    choice = availableProducers.maxBy(=> $0.merit)
    return [
      considerations: [
        [condition: true, score: 0.5 + choice.merit / 1000.0],
        [condition: hero == null || heroProducer == null, score: -1], # prioritize producing a hero
        [condition: unitProducers.size < 3, score: -0.25 * (3 - unitProducers.size)] # need to save up for more unit producers
      ],
      run: fn {
        Console.debug("Training unit with " + choice.skillId)
        Server.cast(choice.producer, null, choice.skillId)
      }
    ]
  }

  playUnit(playableUnits, emptyInfluencedCells, knownGoldSources, params, objective) {
    if playableUnits.isEmpty || emptyInfluencedCells.isEmpty {
      return REJECTED_ACTION
    }
    card = playableUnits.randomItem
    targetCell = null
    if card.type.id == params.miner && !knownGoldSources.isEmpty {
      targetCell = emptyInfluencedCells.minBy(fn (cell) => average(knownGoldSources.map(fn (gold) => gold.distance(cell.coordinates))))
    } else if objective != null {
      # fighters enter the map on the side facing the enemy
      targetCell = emptyInfluencedCells.minBy(=> $0.distance(objective))
    } else {
      targetCell = emptyInfluencedCells.randomItem
    }
    return [
      key: "playUnit:$(card.id)",
      considerations: [
        [condition: true, score: 0.5]
      ],
      run: fn {
        Console.debug("Playing unit")
        Server.play(card, targetCell.coordinates, null)
      }
    ]
  }

  # Cards that summon (units and buildings) need a free cell in the player's territory. When units fill all
  # of it, the hand clogs up with cards that can't be played; this moves a unit out to make room.
  makeRoom(player, playableUnits, emptyInfluencedCells, towards) {
    if playableUnits.isEmpty || !emptyInfluencedCells.isEmpty {
      return REJECTED_ACTION
    }
    best = null
    bestDistance = Int.max
    for unit in player.ownedUnits.where(=> $0.ap > 0 && !$0.isBuilding && !$0.isHero).take(MAX_MOVERS_TO_ANALYZE) {
      here = Game.grid.elementAt(unit.coordinates)
      if here.influencer != player.id {
        continue
      }
      outside = unit.movementRange.where(=> $0.influencer != player.id)
      if outside.isEmpty {
        continue
      }
      cell = if towards == null outside.randomItem else outside.minBy(=> $0.distance(towards))
      distance = if towards == null 0 else cell.distance(towards)
      if distance < bestDistance {
        bestDistance = distance
        best = [unit: unit, cell: cell]
      }
    }
    if best == null {
      return REJECTED_ACTION
    }
    return [
      key: "move:$(best.unit.id)",
      considerations: [
        [condition: true, score: 0.55]
      ],
      run: fn {
        Console.debug("Making room")
        Server.move(best.unit.coordinates, best.cell.coordinates, best.unit.movementCost(best.cell.coordinates))
      }
    ]
  }

  # Chooses the best attack among everything the soldiers can reach this step, using the engine's
  # combat preview: damage dealt, chance to kill and retaliation taken, weighed by what the units are worth.
  attack(hero, soldiers, potentialTargets, needsHero, minScore, message) {
    if needsHero && hero == null { # no point in creeping if no XP is to be gained
      return REJECTED_ACTION
    }
    if soldiers.isEmpty || potentialTargets.isEmpty {
      return REJECTED_ACTION
    }
    targetsByKey = [:]
    for cell in potentialTargets {
      targetsByKey.(coordinatesKey(cell.coordinates)) = cell
    }
    # Only so many soldiers are analyzed, so take the ones closest to a target: in list order, a big army's
    # units standing right next to an enemy could be left out and never strike (Pyracmon's tribes let
    # Kagaalu walk past them).
    targetDistance = [:]
    for soldier in soldiers {
      targetDistance.(soldier.id) = potentialTargets.minBy(=> $0.distance(soldier.coordinates)).distance(soldier.coordinates)
    }
    closest = soldiers.sortedBy(=> targetDistance.($0.id) - targetDistance.($1.id))
    options = []
    for soldier in closest.take(MAX_ATTACKERS_TO_ANALYZE) {
      for reach in soldier.attackRange {
        targetCell = targetsByKey.(coordinatesKey(reach.targetCell.coordinates))
        if targetCell == null {
          continue
        }
        preview = soldier.previewAttack(targetCell.content, reach.viaCell.coordinates)
        if preview == null || !preview.inRange {
          continue
        }
        options.add([soldier: soldier, reach: reach, target: targetCell.content, preview: preview])
      }
    }
    best = null
    bestValue = 0
    for option in options {
      optionValue = @attackValue(option, options)
      if optionValue > bestValue {
        bestValue = optionValue
        best = option
      }
    }
    if best == null {
      return REJECTED_ACTION # nothing worth the losses
    }
    return [
      key: "attack:$(best.soldier.id):$(best.target.id)",
      considerations: [
        [condition: true, score: Math.min(minScore + bestValue / 1000.0, 0.97)]
      ],
      run: fn {
        Console.debug("Attacking $message")
        Server.attack(best.soldier.coordinates, best.reach.targetCell.coordinates, best.reach.viaCell.coordinates, \
          best.reach.movementCost)
      }
    ]
  }

  # What an attack is worth, in merit: share of the target destroyed and kill chance, minus the share of
  # the attacker lost to retaliation and the risk of where it ends up standing.
  attackValue(option, options) {
    preview = option.preview
    target = option.target
    soldier = option.soldier
    targetValue = unitValue(target)
    ownValue = unitValue(soldier)
    gain = targetValue * (preview.damage * 1.0 / Math.max(target.health, 1)) + targetValue * preview.killChance
    loss = ownValue * (preview.retaliation * 1.0 / Math.max(soldier.health, 1))
    if preview.dies {
      loss += ownValue
    }
    if plansAttacks() && !preview.kills {
      others = options.where(=> $0.target.id == target.id && $0.soldier.id != soldier.id)
      followUp = sum(others.map(=> $0.preview.damage))
      if followUp >= preview.targetHp {
        gain += targetValue * 0.5 # the others can finish it off this turn
      }
      if followUp > 0 && target.retaliationPoints > 0 && preview.retaliation < soldier.hp * 0.3 {
        gain += targetValue * 0.15 # a tough unit takes the retaliation, so the others attack freely
      }
    }
    if usesThreatMap() && !preview.dies {
      danger = Game.threatAt(Game.currentPlayer, option.reach.viaCell.coordinates)
      if danger > 0 {
        loss += ownValue * 0.3 * Math.min(1, danger * 1.0 / Math.max(preview.hp, 1))
      }
    }
    return gain - loss
  }

  # Moves the army towards its objective along real paths. Until it's strong enough, the army gathers at
  # home instead of walking into the enemy one unit at a time; stragglers move first so it stays together.
  advance(player, soldiers, objective, home, ready) {
    if objective == null || home == null || soldiers.isEmpty {
      return REJECTED_ACTION
    }
    # gathering happens a few cells out towards the enemy: parked right around the buildings, the army
    # blocked the cells new units and a revived hero appear on
    destination = if ready objective else @rallyPoint(home, objective)
    withinRange = 1
    careful = usesThreatMap() && !ready
    best = null
    bestGain = 0
    for unit in soldiers.shuffled().take(MAX_MOVERS_TO_ANALYZE) {
      step = unit.approach(destination, withinRange)
      if step == null {
        continue
      }
      before = unit.travelCost(destination, withinRange) ?? (step.remaining + 1) # `??` binds tighter than `+`
      gain = before - step.remaining
      if !ready {
        gain += before * 0.1 # stragglers first
      }
      if careful {
        danger = Game.threatAt(player, step.coordinates)
        if danger >= unit.hp {
          continue
        }
        gain -= danger * 2.0 / Math.max(unit.hp, 1)
      }
      if gain > bestGain {
        bestGain = gain
        best = [unit: unit, step: step]
      }
    }
    if best == null {
      return REJECTED_ACTION
    }
    return [
      key: "move:$(best.unit.id)",
      considerations: [
        [condition: true, score: approachScoreForEnemy()]
      ],
      run: fn {
        Console.debug(if ready "Advancing" else "Gathering")
        Server.move(best.unit.coordinates, best.step.coordinates, best.step.movementCost)
      }
    ]
  }

  rallyPoint(home, objective) {
    ring = Game.grid.ringAround(home, HOME_RADIUS)
    if ring.isEmpty {
      return home
    }
    return ring.minBy(=> $0.distance(objective)).coordinates
  }

  # Sends the soldier closest to a creep camp towards it, for hero XP. Path-aware.
  approachCreeps(hero, soldiers, creeps) {
    if hero == null || soldiers.isEmpty || creeps.isEmpty {
      return REJECTED_ACTION
    }
    best = null
    bestRemaining = Int.max
    for unit in soldiers.take(MAX_MOVERS_TO_ANALYZE) {
      if unit.hp < unit.health * 0.5 {
        continue
      }
      location = unit.coordinates
      nearest = creeps.minBy(=> $0.distance(location))
      step = unit.approach(nearest.coordinates, 1)
      if step != null && step.remaining < bestRemaining {
        bestRemaining = step.remaining
        best = [unit: unit, step: step]
      }
    }
    if best == null {
      return REJECTED_ACTION
    }
    return [
      key: "move:$(best.unit.id)",
      considerations: [
        [condition: true, score: approachScoreForCreep()]
      ],
      run: fn {
        Console.debug("Moving to attack creep")
        Server.move(best.unit.coordinates, best.step.coordinates, best.step.movementCost)
      }
    ]
  }

  # Pulls a badly wounded unit out of reach of the enemy, preferably towards home.
  retreat(player, soldiers, home) {
    if !usesThreatMap() {
      return REJECTED_ACTION
    }
    best = null
    bestRelief = 0
    for unit in soldiers {
      if unit.hp >= unit.health * WOUNDED_RATIO {
        continue
      }
      here = Game.threatAt(player, unit.coordinates)
      if here == 0 {
        continue
      }
      safest = unit.movementRange.minBy(fn (cell) => Game.threatAt(player, cell.coordinates) * 100 \
        + (if home == null 0 else cell.distance(home)))
      if safest == null {
        continue
      }
      relief = (here - Game.threatAt(player, safest.coordinates)) * unitValue(unit)
      if relief > bestRelief {
        bestRelief = relief
        best = [unit: unit, cell: safest]
      }
    }
    if best == null {
      return REJECTED_ACTION
    }
    return [
      key: "move:$(best.unit.id)",
      considerations: [
        [condition: true, score: 0.66]
      ],
      run: fn {
        Console.debug("Retreating")
        Server.move(best.unit.coordinates, best.cell.coordinates, best.unit.movementCost(best.cell.coordinates))
      }
    ]
  }

  # Looks at a few casters and returns the best skill any of them can cast (it used to return the
  # first caster's option).
  castSkill(player, casterIds) {
    casters = []
    if player.hero != null && player.hero.coordinates != null {
      casters.add(player.hero)
    }
    nonHeroCasters = player.ownedUnits.where(=> $0.ap > 0 && ($0.type.id in casterIds || $0.type?.aiHints?.skills != null))
    if nonHeroCasters.size > MAX_SKILL_CASTERS_TO_ANALYZE {
      casters.addAll(nonHeroCasters.shuffled().take(MAX_SKILL_CASTERS_TO_ANALYZE))
    } else {
      casters.addAll(nonHeroCasters)
    }
    best = null
    bestScore = 0
    for caster in casters {
      option = @skillOptionFor(player, caster)
      if option == null {
        continue
      }
      optionScore = @sumScores(option.considerations) # inherited methods need @ (see FindCompiledClass)
      if optionScore > bestScore {
        bestScore = optionScore
        best = option
      }
    }
    return best ?? REJECTED_ACTION
  }

  skillOptionFor(player, caster) {
    casterLocation = caster.coordinates
    when caster.type.id {
      # Sanghoy
      "pyracmon" {
        groundSlamScore = 0
        bashScore = 0
        bashTarget = null
        if skillCanBeCast(player, caster, "groundSlam") {
          groundSlamScore = Game.unitsInRange(casterLocation, 1).count(=> !caster.owner.isAllyOf($0.owner)) * 0.15
        }
        if skillCanBeCast(player, caster, "bash") {
          targets = Game.castTargets(casterLocation, caster, "bash")
          bashScore = targets.size * 0.3
          if bashScore > 0 {
            bashTarget = targets.maxBy(=> $0.content.type.merit ?? 0)
          }
        }
        if groundSlamScore > 0 && groundSlamScore > bashScore {
          return [
            considerations: [
              [condition: true, score: groundSlamScore]
            ],
            run: fn {
              Console.debug("Casting ground slam")
              Server.cast(caster, null, "groundSlam")
            }
          ]
        } else if bashScore > 0 {
          return [
            considerations: [
              [condition: true, score: bashScore]
            ],
            run: fn {
              Console.debug("Casting bash")
              Server.cast(caster, bashTarget.coordinates, "bash")
            }
          ]
        }
      }

      "maim" {
        warcryScore = 0
        leapAttackScore = 0
        leapTarget = null
        if skillCanBeCast(player, caster, "beastmastersWarcry") {
          warcryScore = Game.unitsInRange(casterLocation, 2).count(=> caster.owner.isAllyOf($0.owner)) * 0.2
        }
        if skillCanBeCast(player, caster, "leapAttack") {
          targets = Game.castTargets(casterLocation, caster, "leapAttack")
          leapAttackScore = targets.size * 0.3
          if leapAttackScore > 0 {
            leapTarget = targets.maxBy(=> $0.content.type.merit ?? 0)
          }
        }
        if warcryScore > 0 && warcryScore > leapAttackScore {
          return [
            considerations: [
              [condition: true, score: warcryScore]
            ],
            run: fn {
              Console.debug("Casting beastmasters Warcry")
              Server.cast(caster, null, "beastmastersWarcry")
            }
          ]
        } else if leapAttackScore > 0 {
          return [
            considerations: [
              [condition: true, score: leapAttackScore]
            ],
            run: fn {
              Console.debug("Casting leap attack")
              Server.cast(caster, leapTarget.coordinates, "leapAttack")
            }
          ]
        }
      }

      "kagaalu" {
        unitsAround = Game.unitsInRange(casterLocation, 2)
        allies = unitsAround.where(=> caster.owner.isAllyOf($0.owner))
        enemiesCount = unitsAround.size - allies.size
        return castBestTargetableSkill(player, caster, [
          "sacrificeOfDeath": enemiesCount * 0.2,
          "sacrificeOfVigor": allies.size * 0.1,
          "sacrificeOfHealth": allies.count(=> $0.hp < $0.health) * 0.1,
          "kagaalusSarcomancy": 0.2
        ])
      }

      "thrall" {
        if totalCountForUnitType("sacrificialWell") == 0 \
          && totalCountForUnitType("totem") > 0 \
          && totalCountForUnitType("shaper") > 0 \
          && skillCanBeCast(player, caster, "buildSacrificialWell") {
          return [
            considerations: [
              [condition: true, score: 0.9]
            ],
            run: fn {
              Console.debug("Casting build sac well")
              Server.cast(caster, null, "buildSacrificialWell")
            }
          ]
        }
        return castBestTargetableSkill(player, caster, [
          "thrallRepair": 0.4
        ])
      }

      "sarcomancer" {
        return castBestTargetableSkill(player, caster, [
          "sarcomancy": 0.6,
          "amalgamation": 0.80,
          "sarcomancerHeal": Game.unitsInRange(casterLocation, 1).count(=> $0.hp < $0.health) * 0.15
        ])
      }

      "raider" {
        # Rise to Warchief morphs whatever stands on the cast cell, but Game.castTargets lists every unit in
        # range (it ignores the skill's own "none" targeting), so aim it at the raider's own cell. A random
        # pick could hit a neighbouring hero ("Can't morph heroes!").
        selfTarget = Game.castTargets(casterLocation, caster, "riseToWarchief").first(=> $0.content?.id == caster.id)
        if selfTarget == null {
          return null
        }
        return castBestTargetableSkill(player, caster, [
          "riseToWarchief": 0.6 - 0.05 * player.ownedUnits.count(=> $0.type.id == "warchief")
        ], fn (skill, targets) => selfTarget)
      }

      "sacrificialWell" {
        if player.resources.u < 5 && skillCanBeCast(player, caster, "sacrificeOfBlood") {
          sacrifice = Game.castTargets(casterLocation, caster, "sacrificeOfBlood").minBy(=> $0.content.type.merit ?? 0)
          if sacrifice != null {
            return [
              considerations: [
                [condition: true, score: 0.75]
              ],
              run: fn {
                Console.debug("Casting sacrificeOfBlood")
                Server.cast(caster, sacrifice.coordinates, "sacrificeOfBlood")
              }
            ]
          }
        }
      }

      "totem" {
        if totalCountForSpellType("bloodlust") < 1 && skillCanBeCast(player, caster, "addBloodlust") {
          return [
            considerations: [
              [condition: true, score: 0.3]
            ],
            run: fn {
              Console.debug("Casting addBloodlust")
              Server.cast(caster, null, "addBloodlust")
            }
          ]
        }
      }

      # Frenza
      "denburhin" {
        recrewScore = 0
        aimForTheSunScore = 0
        aimTarget = null
        if skillCanBeCast(player, caster, "recrewDenburhin") {
          if !Game.castTargets(casterLocation, caster, "recrewDenburhin").isEmpty {
            recrewScore = 0.75 - caster.hp / caster.health
          }
        }
        if skillCanBeCast(player, caster, "aimForTheSun") {
          targets = Game.castTargets(casterLocation, caster, "aimForTheSun")
          if !targets.isEmpty && caster.hp / caster.health <= 0.5 {
            aimForTheSunScore = 0.3 + Game.unitsInRange(casterLocation, 1).count(=> !areAllies(caster, $0)) * 0.1
            aimTarget = targets.randomItem
          }
        }
        if recrewScore > 0 && recrewScore > aimForTheSunScore {
          return [
            considerations: [
              [condition: true, score: recrewScore]
            ],
            run: fn {
              Console.debug("Casting Denburhin recrew")
              Server.cast(caster, null, "recrewDenburhin")
            }
          ]
        } else if aimForTheSunScore > 0 {
          return [
            considerations: [
              [condition: true, score: aimForTheSunScore]
            ],
            run: fn {
              Console.debug("Casting aim for the sun")
              Server.cast(caster, aimTarget.coordinates, "aimForTheSun")
            }
          ]
        }
      }

      # Each skill has its own target now. They shared one, so a later check could overwrite it and e.g.
      # Tofan's kiss was cast on the plague seeds target. Noxious cloud targets a cell, and used to be cast
      # with no target at all.
      "tofan" {
        noxiousCloudScore = 0
        tofansKissScore = 0
        plagueSeedsScore = 0
        cloudTarget = null
        kissTarget = null
        seedsTarget = null
        if skillCanBeCast(player, caster, "noxiousCloud") {
          for cell in Game.castTargets(casterLocation, caster, "noxiousCloud") {
            unitsAround = Game.unitsInRange(cell.coordinates, 1)
            enemiesAroundCount = unitsAround.count(=> !areAllies($0, caster))
            cellScore = enemiesAroundCount * 0.3 - (unitsAround.size - enemiesAroundCount) * 0.1
            if cellScore > noxiousCloudScore {
              noxiousCloudScore = cellScore
              cloudTarget = cell
            }
          }
        }
        if skillCanBeCast(player, caster, "tofansKiss") {
          targets = Game.castTargets(casterLocation, caster, "tofansKiss")
          if !targets.isEmpty {
            kissTarget = targets.maxBy(=> $0.content.type.merit)
            tofansKissScore = kissTarget.content.type.merit / 1100 # almost guarantees casting on heroes
          }
        }
        if skillCanBeCast(player, caster, "plagueSeeds") {
          for cell in Game.castTargets(casterLocation, caster, "plagueSeeds") {
            unitsAround = Game.unitsInRange(cell.coordinates, 1)
            friendsOfTarget = unitsAround.count(=> areAllies($0, cell.content))
            cellScore = friendsOfTarget * 0.3 + (unitsAround.size - friendsOfTarget) * 0.05
            if cellScore > plagueSeedsScore {
              plagueSeedsScore = cellScore
              seedsTarget = cell
            }
          }
        }
        if noxiousCloudScore > 0 && noxiousCloudScore > tofansKissScore && noxiousCloudScore > plagueSeedsScore {
          return [
            considerations: [
              [condition: true, score: noxiousCloudScore]
            ],
            run: fn {
              Console.debug("Casting noxious cloud")
              Server.cast(caster, cloudTarget.coordinates, "noxiousCloud")
            }
          ]
        } else if tofansKissScore > 0 && tofansKissScore > plagueSeedsScore {
          return [
            considerations: [
              [condition: true, score: tofansKissScore]
            ],
            run: fn {
              Console.debug("Casting Tofan's kiss")
              Server.cast(caster, kissTarget.coordinates, "tofansKiss")
            }
          ]
        } else if plagueSeedsScore > 0 {
          return [
            considerations: [
              [condition: true, score: plagueSeedsScore]
            ],
            run: fn {
              Console.debug("Casting plague seeds")
              Server.cast(caster, seedsTarget.coordinates, "plagueSeeds")
            }
          ]
        }
      }

      "settler" {
        return castBestTargetableSkill(player, caster, [
          "settlerRepair": 0.4,
          "foundColony": 1 - totalCountForUnitType("colonialHall") * 0.35,
          "foundPlantation": 0.75 - totalCountForUnitType("plantation") * 0.25
        ])
      }

      "rifleman" {
        if Game.unitsInRange(casterLocation, 2).count(=> !areAllies($0, caster)) == 0 {
          return castBestTargetableSkill(player, caster, [
            "mountToDragoon": 0.76
          ])
        }
      }

      "dragoon" {
        if Game.unitsInRange(casterLocation, 2).count(=> !areAllies($0, caster)) >= 2 {
          return castBestTargetableSkill(player, caster, [
            "dismoutToRifleman": 0.57 # sic: that's the skill's id in the data (FrenzaSkills.yaml)
          ])
        }
      }

      "steamGolem" {
        return castBestTargetableSkill(player, caster, [
          "concussiveGrenade": sum(Game.unitsInRange(casterLocation, 2).where(=> !areAllies(caster, $0)).map(=> $0.type.merit / 1100)),
          "retrofitToVoltWalker": 0.6 - 0.05 * player.ownedUnits.count(=> $0.type.id == "voltWalker")
        ])
      }

      "devilhornTank" {
        return castBestTargetableSkill(player, caster, [
          "recrew": 0.75 - caster.hp / caster.health,
          "retrofitToVoltTank": 0.6 - 0.05 * player.ownedUnits.count(=> $0.type.id == "voltTank")
        ])
      }

      "voltTank" || "assaultAirship" {
        return castBestTargetableSkill(player, caster, [
          "recrew": 0.75 - caster.hp / caster.health
        ])
      }

      "mev" {
        # compares type ids: `$0.type in [...]` compared the type object to strings and was never true
        infantryAround = Game.unitsInRange(casterLocation, 1).count(=> areAllies(caster, $0) && $0.type.id in ["rifleman", "dragoon"])
        return castBestTargetableSkill(player, caster, [
          "combatShields": infantryAround * 0.2,
          "amalgamation": infantryAround * 0.15 + Game.unitsInRange(casterLocation, 2).count(=> !areAllies(caster, $0)) * 0.1,
          "patchEmUp": Game.unitsInRange(casterLocation, 1).count(=> $0.hp < $0.health) * 0.15
        ])
      }

      "colonialHall" {
        if player.resources.u < 5 {
          return castBestTargetableSkill(player, caster, [
            "buildMonument": 1 - 0.15 * player.ownedUnits.count(=> $0.type.id.startsWith("monument")),
            "sendTribute": if (player.resources.g > 30) player.resources.g / 50.0 else 0
          ])
        }
      }

      "airfield" {
        if totalCountForSpellType("paradrop") < 1 && skillCanBeCast(player, caster, "addParadrop") {
          return [
            considerations: [
              [condition: true, score: 0.3]
            ],
            run: fn {
              Console.debug("Casting addParadrop")
              Server.cast(caster, null, "addParadrop")
            }
          ]
        }
      }

      "magistratesCourt" {
        shipments = ["shipEndlessExpansion", "shipEradicateThePest", "shipAirSuperiority", "shipEmperorsFist"] \
          .mapToObject(=> $0, => if skillCanBeCast(player, caster, $0) 0.9 else 0)
        return castBestTargetableSkill(player, caster, shipments)
      }
    }

    # Everything else, including new and modded units: the skill priorities from the faction data.
    return castBestTargetableSkill(player, caster, dataSkillScores(caster))
  }

  # Weighs every playable spell and casts the best one (it used to cast the first it could target).
  # Spells that drop units are aimed at the army's objective rather than the middle of the map.
  castSpell(player, playableCards, spellIds, enemies, focus) {
    spells = playableCards.where(=> $0.type.id in spellIds || $0.type.id in NEUTRAL_SPELLS)
    if spells.isEmpty {
      return REJECTED_ACTION
    }
    towardsFocus = fn (targets) => if focus == null targets.randomItem else targets.minBy(=> $0.distance(focus))
    best = null
    bestScore = 0
    for spell in spells {
      id = spell.type.id
      scoreAndTargetPredicate = when id {
        "bloodlust" => [
          score: Math.min(0.35, 0.1 * player.ownedUnits.count(=> $0.ap < $0.speed)),
          target: fn (targets) => targets.maxBy(=> $0.content.type.merit)
        ]
        "sanghoyHorde" => [
          score: Math.min(0.7, 0.15 * enemies.size),
          target: towardsFocus
        ]
        "karrish" => [
          score: Math.min(0.7, 0.15 * enemies.size),
          target: fn (targets) => targets.maxBy(=> $0.content.type.merit)
        ]
        "bloodToRogash" => [
          score: Math.min(0.7, (if (player.resources.u < 5) 0.23 else 0) + enemies.size * 0.1)
        ]
        "horribleMisshaping" => [
          score: Math.min(0.8, 0.2 * enemies.size),
          target: fn (targets) => targets.maxBy(=> $0.content.type.merit)
        ]

        "valiantPromotion" => [
          score: Math.min(0.8, 0.2 * enemies.size),
          target: fn (targets) => targets.maxBy(=> $0.content.type.merit)
        ]
        "paradrop" => [
          score: Math.min(0.8, 0.2 * enemies.size),
          target: towardsFocus
        ]
        "endlessExpansionShipment" || "airSuperiorityShipment" || "eradicateThePestShipment" \
          || "emperorsFistShipment" || "hardenedVeteransShipment" || "scrapyardColossusShipment" => [
          score: 1, # always cast
          target: towardsFocus
        ]
        "theNextGenerationShipment" => [
          score: player.ownedUnits.count(=> $0.type.id == "settler") * 0.1,
          target: towardsFocus
        ]
        "theCulling" => [
          score: enemies.count(=> $0.content.hp < 20) * 0.2
        ]

        # neutral spells, gained from map objects
        "mercilessAssassination" => [
          score: 0.95, # kills an enemy hero outright
          target: fn (targets) => targets.maxBy(=> $0.content.type.merit)
        ]
        else => null # not handled
      }
      if scoreAndTargetPredicate == null {
        continue
      }
      spellScore = scoreAndTargetPredicate::score
      if spellScore <= bestScore {
        continue
      }
      targets = Game.spellTargets(spell)
      if targets == null { # not enabled
        continue
      }
      targetPosition = null
      if targets is List {
        if targets.isEmpty {
          continue
        }
        pickTarget = scoreAndTargetPredicate::target
        selectedTarget = if pickTarget == null targets.randomItem else pickTarget(targets)
        targetPosition = selectedTarget.coordinates
      }
      bestScore = spellScore
      best = [spell: spell, id: id, position: targetPosition]
    }
    if best == null {
      return REJECTED_ACTION
    }
    return [
      key: "spell:$(best.spell.id)",
      considerations: [
        [condition: true, score: bestScore]
      ],
      run: fn {
        Console.debug("Casting spell $(best.id)")
        Server.play(best.spell, best.position, null)
      }
    ]
  }

  explore(player) {
    # fighters explore; builders and miners have better things to do
    unitsThatCanMove = player.ownedUnits.where(=> $0.ap > 0 && $0.type.a > 0 && !$0.isBuilding)
    if unitsThatCanMove.isEmpty {
      return REJECTED_ACTION
    }
    firstUnitWithMovementRange = null
    for unit in unitsThatCanMove {
      mr = unit.movementRange
      if !mr.isEmpty {
        firstUnitWithMovementRange = [unit, mr]
        break
      }
    }
    if firstUnitWithMovementRange == null {
      return REJECTED_ACTION
    }

    unit = firstUnitWithMovementRange.0
    unitLocation = unit.coordinates
    hiddenCellsAround = Game.grid.cellsAround(unitLocation, unit.sight + 1, player) \
      .where(=> $0.hasFogOfWar(player))
    if hiddenCellsAround.isEmpty {
      # if nothing's hidden around, move towards the nearest hidden part of the map
      hiddenCellsAround = Game.grid.hiddenCells(player)
    }

    if hiddenCellsAround.isEmpty { # there's no FOW anywhere
      return REJECTED_ACTION
    }

    nearestCell = null
    minDistance = Float.max

    for mrCell in firstUnitWithMovementRange.1 {
      nearestHiddenCell = hiddenCellsAround.minBy(=> $0.distance(mrCell.coordinates))
      distance = nearestHiddenCell.distance(mrCell.coordinates)
      if distance < minDistance {
        nearestCell = mrCell
        minDistance = distance
      }
    }
    target = nearestCell.coordinates

    return [
      key: "move:$(unit.id)",
      considerations: [
        [condition: true, score: 0.2] # exploring is generally a low-level action
      ],
      run: fn {
        Console.debug("Exploring")
        Server.move(unitLocation, target, unit.movementCost(target))
      }
    ]
  }

  changeStance(hero, soldiers, enemies) {
    candidates = []
    if hero != null && hero.coordinates != null && hero.ap > 0 {
      candidates.add(hero)
    }
    nonHeroCandidates = soldiers.where(=> $0.ap > 0) # TODO handle building stances as well
    if nonHeroCandidates.size > MAX_STANCE_CHANGES_TO_ANALYZE {
      candidates.addAll(nonHeroCandidates.shuffled().take(MAX_STANCE_CHANGES_TO_ANALYZE))
    } else {
      candidates.addAll(nonHeroCandidates)
    }
    if candidates.isEmpty {
      return REJECTED_ACTION
    }
    params = [score: 0, newStance: null, unit: null]
    for unit in candidates {
      stanceScore = 0
      newStance = null
      currentStance = unit.activeStance.name
      availableStances = unit.availableStances
      location = Game.grid.locate(unit)
      nearbyEnemiesCount = enemies.count(=> location.distance($0.coordinates) <= 3)
      if currentStance != "Camp" && unit.hp < unit.health * 0.3 && "Camp" in availableStances && nearbyEnemiesCount == 0 {
        stanceScore = 0.7
        newStance = "Camp"
      } else if currentStance != "Defense" && "Defense" in availableStances && nearbyEnemiesCount >= 2 {
        stanceScore = 0.5
        newStance = "Defense"
      } else if currentStance != "March" && "March" in availableStances && unit.hp >= unit.health * 0.7 && nearbyEnemiesCount == 0 {
        stanceScore = 0.65
        newStance = "March"
      }

      # Frenza specific
      else if currentStance == "DeployAutoturret" && nearbyEnemiesCount == 0 {
        stanceScore = 0.7
        newStance = "PackAutoturret"
      } else if currentStance == "PackAutoturret" && nearbyEnemiesCount > 0 {
        stanceScore = 0.7
        newStance = "DeployAutoturret"
      } else if currentStance != "Snipe" && "Snipe" in availableStances {
        stanceScore = 0.67
        newStance = "Snipe"
      }

      if stanceScore > params.score {
        params.score = stanceScore
        params.newStance = newStance
        params.unit = unit
      }
    }
    if params.unit == null {
      return REJECTED_ACTION
    }
    return [
      key: "stance:$(params.unit.id)",
      considerations: [
        [condition: true, score: params.score]
      ],
      run: fn {
        Console.debug("Changing stance to $(params.newStance).")
        Server.changeStance(params.unit, params.newStance)
      }
    ]
  }

  interact(player) {
    units = player.ownedUnits.where(=> $0.type.canInteract && $0.ap > 0).shuffled().take(MAX_INTERACTORS_TO_ANALYZE)
    for unit in units {
      interactable = Game.grid.cellsAround(unit.coordinates, 1, player) \
        .first(=> $0.content != null && $0.content.owner.id == Game.nature.id && $0.content.type?.interactionEffect != null)
      if interactable != null {
        return [
          key: "interact:$(unit.id)",
          considerations: [
            [condition: true, score: 0.22] # interaction should be a low-priority action
          ],
          run: fn {
            Console.debug("Interacting with $(interactable.content.type.id)")
            Server.interact(unit.coordinates, interactable.coordinates)
          }
        ]
      }
    }
    return REJECTED_ACTION
  }

  concede(player, playableCards, miners, hero, heroProducer, unitProducers, soldiers) {
    if Game.turn < 15 { # can't concede before round 15, to give it time to build up
      return REJECTED_ACTION
    }
    if hero?.coordinates != null \
        || soldiers.size > 3 \
        || (unitProducers.size > 1 && player.resources.g > 10) \
        || (heroProducer != null && skillCanBeCast(player, heroProducer, "reviveHero")) \
        || (miners.size > 1 && !unitProducers.isEmpty) {
      return REJECTED_ACTION
    }
    return [
      considerations: [
        [condition: true, score: 1]
      ],
      run: fn {
        Console.debug("Conceding because I suck! ($(player.name))")
        Server.concede(player)
      }
    ]
  }
}

# Difficulty tiers. They used to share all the logic; the only differences were the number of moves
# per turn and Hard's extra starting resources.

# Makes mistakes: noisy scores, attacks with whatever is at hand, doesn't watch for danger.
ai EasyAi is MeleeAi {
  init {
    @maxMoves = 12
  }

  scoreNoise => 0.15
  usesThreatMap => false
  advanceRatio => 0
}

ai NormalAi is MeleeAi {
  init {
    @maxMoves = 50
  }
}

# Same rules as everyone else, but coordinates its attacks within a turn and commits a bit earlier.
ai HardAi is MeleeAi {
  init {
    @maxMoves = 80
  }

  plansAttacks => true
  advanceRatio => 1.15
}

# Hard, plus extra starting resources (what "Hard" used to be on its own).
ai BrutalAi is HardAi {
  # a class without its own init gets an empty one, not its parent's
  init {
    @maxMoves = 80
  }

  onGameStart(player) {
    Console.debug("Cheating by adding more resources!")
    player.addResources([g: 25, u: 5])
  }
}
