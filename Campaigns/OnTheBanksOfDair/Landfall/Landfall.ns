# On the Banks of Dair, mission 2: Landfall. The outsiders' side of the story: the Frenza expedition comes ashore at
# the mouth of the Dair, the morning after the tribe fled across the river.
#
# Act 1: a settler founds the Colonial Hall on the beach (lose every settler before that and the landing fails).
# Act 2: the Hall builds a Barracks. Pyracmon's camps start sending warbands at the beach, and the flagship at anchor
#        lands riflemen every few turns and shells whoever comes near the water.
# Act 3: destroy the camps (2 on normal, 3 on hard); each one destroyed stops its warbands. Optional: kill the camps'
#        warchiefs with assassins.
#
# Map markers (cell comments): landing, anchorage, camp (one per camp on the map), farCamp (summoned on hard).
# Everything that must survive a save is kept in objectives or in scenario extras (strings and numbers only).
# Dialogs only reach the human on their own turn, so anything that happens off-turn is queued (see onStateChange).
scenario Landfall {
  GRACE_TURNS = 2 # after the colony is founded, before the first warbands leave the camps
  FIRST_WAVE_NORMAL = 6 # the warbands come by this turn even if there's no colony yet
  FIRST_WAVE_HARD = 5
  CHASE_RANGE = 3 # a warband goes for the nearest outsider this close, otherwise for the Colonial Hall
  FLAGSHIP_REACH = 4
  MAX_REINFORCEMENTS = 5
  CAMP_HEALTH_NORMAL = 90
  WATER = ["river", "sea"]
  TRIBE_TYPES = ["sanghoyCamp", "warchief", "warrior", "thrall", "raider"]

  OBJ_COLONY = "colony"
  OBJ_BARRACKS = "barracks"
  OBJ_CAMPS = "camps"
  OBJ_WARCHIEFS = "warchiefs"

  # Scenario extras
  KEY_CAMPS = "camps"
  KEY_WARCHIEFS = "warchiefs"
  KEY_WARBANDS = "warbands"
  KEY_NEXT_WAVE = "nextWave"
  KEY_WAVES = "waves"
  KEY_NEXT_REINFORCEMENT = "nextReinforcement"
  KEY_REINFORCEMENTS = "reinforcements"
  KEY_ASSASSINATED = "assassinated"
  KEY_PENDING = "pending" # events waiting for the human's turn, as ",event,event,"
  KEY_WARCHIEF_COUNT = "warchiefCount" # the camps' warchiefs are kept as "warchief:0", "warchief:1", ...
  # Queued events, in the order they're told to the human.
  EVENTS = ["firstWarband", "warband", "reinforcements", "settlerLanded", "assassinated", "warchiefLost", "campFell", "victory"]

  # ------------------------------------------------------------------ setup

  onStart {
    if Game.currentScenario.objectives.isEmpty { # a loaded game is already set up
      @setUpMap()
      @playIntro()
    }
  }

  setUpMap {
    player = @human()
    navy = Game.players.1
    pyracmon = @tribes()
    natureId = Game.nature.id
    landing = Game.grid.elementAt(Game.grid.startingLocations.0)
    for unit in Game.grid.allUnits.where(=> $0.owner.id == natureId && $0.coordinates != null) {
      typeId = unit.type.id
      if typeId in ["settler", "rifleman"] && landing.distance(unit.coordinates) <= 3 {
        unit.setOwner(player)
      } else if typeId == "ironclad" {
        unit.setOwner(navy)
      } else if typeId in TRIBE_TYPES {
        unit.setOwner(pyracmon)
      }
    }
    if @isHard() {
      far = @marker("farCamp")
      if far != null && far.content == null {
        far.summon("sanghoyCamp", pyracmon)
        @freeCellNear(far.coordinates).summon("warchief", pyracmon)
        @freeCellNear(far.coordinates).summon("warrior", pyracmon)
      }
    }
    for camp in @tribeUnits("sanghoyCamp") {
      @addToSet(KEY_CAMPS, camp.id)
      if @isHard() {
        @freeCellNear(camp.coordinates).summon("warrior", pyracmon) # one more guard
      } else {
        camp.setHealth(CAMP_HEALTH_NORMAL)
      }
      # The navy's scouts marked the camps on the captain's map.
      Game.currentScenario.addRevealedCell(camp.coordinates)
      for near in Game.grid.ringAround(camp.coordinates, 1) {
        Game.currentScenario.addRevealedCell(near.coordinates)
      }
    }
    index = 0
    for warchief in @tribeUnits("warchief") {
      @addToSet(KEY_WARCHIEFS, warchief.id)
      @remember("warchief:" + index, warchief.id)
      index += 1
    }
    @remember(KEY_WARCHIEF_COUNT, index)
    @remember(KEY_ASSASSINATED, 0)
    @remember(KEY_WAVES, 0)
    @remember(KEY_REINFORCEMENTS, 0)
    @remember(KEY_NEXT_REINFORCEMENT, 1 + @reinforceEvery())
    @remember(KEY_NEXT_WAVE, if @isHard() FIRST_WAVE_HARD else FIRST_WAVE_NORMAL)
    Game.refreshState()
  }

  playIntro {
    @pauseTimer()
    Game.positionCamera(@markerAt("anchorage"))
    Game.zoomCamera(8)
    Game.wait(0.5)
    @flagshipSound()
    @captainSays("lfIntro1")
    Game.positionCamera(Game.grid.startingLocations.0)
    @captainSays(if @playedCalamity() "lfIntro2Fled" else "lfIntro2")
    @navySays("lfIntro3")
    @captainSays("lfIntro4")
    @startObjective(OBJ_COLONY, "lfColony", "colonialHall", null)
    @say("settler", @human(), "settlerTitle", "lfColonyHint")
    @resumeTimer()
  }

  # ------------------------------------------------------------------ events

  onSkillCast(caster, skillId) {
    if skillId == "foundColony" && caster.owner?.id == @human().id && @isActive(OBJ_COLONY) {
      @colonyFounded()
    }
  }

  onCardPlay(card) {
    if Game.currentPlayerIndex == 0 && card.type.id == "barracks" && @isActive(OBJ_BARRACKS) {
      @barracksBuilt()
    }
  }

  onAttack(attacker, defender) {
    @creditWarchiefHit(attacker, defender)
    @creditWarchiefHit(defender, attacker) # a warchief cut down by retaliation
  }

  onDie(unit) {
    typeId = unit.type.id
    if unit.owner.id == @human().id {
      if typeId == "colonialHall" && @human().ownedUnits.count(=> $0.type.id == "colonialHall" && $0.id != unit.id) == 0 {
        @defeat("lfHallFell")
      } else if typeId == "settler" && @isActive(OBJ_COLONY) && @human().ownedUnits.count(=> $0.type.id == "settler" && $0.id != unit.id) == 0 {
        @defeat("lfSettlersLost")
      }
    } else if @inSet(KEY_CAMPS, unit.id) {
      @queue("campFell")
    } else if @inSet(KEY_WARCHIEFS, unit.id) {
      # Who struck the last blow is only known once the attack is over (onAttack runs after onDie); a warchief that
      # dies off-turn (of poison) keeps whoever hit him last.
      @remember("fallen:" + unit.id, "yes")
    }
  }

  onStateChange {
    if Game.currentPlayerIndex == 0 && (@recall(KEY_PENDING) ?? "") != "" {
      events = @recall(KEY_PENDING)
      @remember(KEY_PENDING, "")
      @pauseTimer()
      for event in EVENTS.where(=> ("," + $0 + ",") in events) {
        @announce(event)
      }
      @resumeTimer()
    }
  }

  onTurnStart {
    @settleFallenWarchiefs()
    @sendWarbands()
    @marchWarbands()
    @flagshipFires()
    @reinforce()
  }

  checkVictory => null

  # ------------------------------------------------------------------ act 1: the colony

  colonyFounded {
    @pauseTimer()
    @complete(OBJ_COLONY)
    @remember(KEY_NEXT_WAVE, Math.max(@recall(KEY_NEXT_WAVE) ?? 0, Game.turn + GRACE_TURNS))
    hall = @unitOf(@human(), "colonialHall")
    if hall != null {
      Game.positionCamera(hall.coordinates)
    }
    @captainSays("lfFounded1")
    @startObjective(OBJ_BARRACKS, "lfBarracks", "barracks", null)
    @say("settler", @human(), "settlerTitle", "lfBarracksHint")
    @say("settler", @human(), "settlerTitle", "lfMineHint")
    @resumeTimer()
  }

  # ------------------------------------------------------------------ act 2: the barracks

  barracksBuilt {
    @pauseTimer()
    @complete(OBJ_BARRACKS)
    @captainSays("lfBarracks1")
    @startObjective(OBJ_CAMPS, "lfCamps", "sanghoyCamp", @campsDescription())
    @navySays("lfWarchiefs1")
    @captainSays("lfWarchiefs2")
    @startObjective(OBJ_WARCHIEFS, "lfWarchiefs", "assassin", @warchiefsDescription())
    @say("assassin", @human(), "assassinTitle", "lfAssassinHint")
    @resumeTimer()
    if @unitsIn(KEY_CAMPS).isEmpty { # every camp already burned
      @queue("victory")
    }
  }

  # ------------------------------------------------------------------ act 3: the camps

  announce(event) {
    if event == "campFell" {
      @campFell()
    } else if event == "victory" {
      @victory()
    } else if event == "warband" {
      Game.showMessage(@t("lfWarband"))
    } else if event == "firstWarband" {
      @navySays("lfFirstWarband")
    } else if event == "reinforcements" {
      Game.showMessage(@t("lfReinforcements"))
    } else if event == "settlerLanded" {
      @navySays("lfSettlerLanded")
    } else if event == "assassinated" {
      Game.showMessage(@t("lfAssassinated"))
      @updateWarchiefs()
    } else if event == "warchiefLost" {
      @updateWarchiefs()
    }
  }

  campFell {
    left = @unitsIn(KEY_CAMPS).count(=> true)
    if @isActive(OBJ_CAMPS) {
      Game.currentScenario.updateObjective(OBJ_CAMPS, [description: @campsDescription()])
      Game.refreshState()
    }
    if left == 0 {
      if !@isActive(OBJ_BARRACKS) && !@isActive(OBJ_COLONY) {
        @victory()
      }
    } else {
      @captainSays("lfCampFell")
    }
  }

  victory {
    if !@isActive(OBJ_CAMPS) {
      return # already over
    }
    @pauseTimer()
    @settleFallenWarchiefs()
    player = @human()
    @complete(OBJ_CAMPS)
    if @isActive(OBJ_WARCHIEFS) {
      if @warchiefsLeft() == 0 && @assassinated() == @warchiefCount() {
        @complete(OBJ_WARCHIEFS)
      } else {
        @fail(OBJ_WARCHIEFS)
      }
    }
    hall = @unitOf(player, "colonialHall")
    if hall != null {
      Game.positionCamera(hall.coordinates)
    }
    @captainSays("lfVictory1")
    @navySays("lfVictory2")
    @captainSays(if @isDone(OBJ_WARCHIEFS) "lfVictory3Assassins" else "lfVictory3")
    @saveProgress()
    Server.win(player)
  }

  # What later missions can build on.
  saveProgress {
    campaign = Game.campaign
    if campaign != null {
      progress = campaign.progressFor("Landfall")
      if progress != null {
        progress.addOrUpdateExtra("turns", "turns", "", Game.turn)
        progress.addOrUpdateExtra("warchiefsAssassinated", "warchiefsAssassinated", "", @assassinated())
        progress.addOrUpdateExtra("settlers", "settlers", "", @human().ownedUnits.count(=> $0.type.id == "settler"))
      }
      campaign.unlock("ThroughTheMire") # chapter 3
      campaign.save()
    }
  }

  defeat(lineKey) {
    for objectiveId in [OBJ_COLONY, OBJ_BARRACKS, OBJ_CAMPS, OBJ_WARCHIEFS].where(=> @isActive($0)) {
      @fail(objectiveId)
    }
    Game.showMessageToAll(@t(lineKey))
    Game.lose(@human())
    Game.refreshState()
  }

  # ------------------------------------------------------------------ the warchiefs

  # Marks who last hit one of the camps' warchiefs: an assassin, or anyone else of the human's.
  creditWarchiefHit(hitter, warchief) {
    if hitter == null || warchief == null || !@inSet(KEY_WARCHIEFS, warchief.id) || hitter.owner?.id != @human().id {
      return
    }
    byAssassin = hitter.type.id == "assassin"
    @remember("lastHit:" + warchief.id, if byAssassin "assassin" else "other")
    if @recall("fallen:" + warchief.id) == "yes" {
      @settleWarchief(warchief.id)
    }
  }

  # Warchiefs that died without an attack to settle it (poison, the flagship): whoever hit them last gets the credit.
  settleFallenWarchiefs {
    for index in 0..@warchiefCount() {
      warchiefId = @recall("warchief:" + index)
      if @recall("fallen:" + warchiefId) == "yes" {
        @settleWarchief(warchiefId)
      }
    }
  }

  settleWarchief(warchiefId) {
    @remember("fallen:" + warchiefId, "settled")
    if @recall("lastHit:" + warchiefId) == "assassin" {
      @remember(KEY_ASSASSINATED, @assassinated() + 1)
      @queue("assassinated")
    } else {
      @queue("warchiefLost")
    }
  }

  updateWarchiefs {
    if @isActive(OBJ_WARCHIEFS) {
      Game.currentScenario.updateObjective(OBJ_WARCHIEFS, [description: @warchiefsDescription()])
      if @warchiefsLeft() == 0 {
        if @assassinated() == @warchiefCount() {
          @complete(OBJ_WARCHIEFS)
          @captainSays("lfAllAssassinated")
        } else {
          @fail(OBJ_WARCHIEFS)
        }
      }
      Game.refreshState()
    }
  }

  assassinated => @recall(KEY_ASSASSINATED) ?? 0
  warchiefCount => @recall(KEY_WARCHIEF_COUNT) ?? 0
  warchiefsLeft => @unitsIn(KEY_WARCHIEFS).count(=> true)
  campsDescription => @t("lfCampsDescription").format([@unitsIn(KEY_CAMPS).count(=> true)])
  warchiefsDescription => @t("lfWarchiefsDescription").format([@assassinated(), @warchiefCount()])

  # ------------------------------------------------------------------ Pyracmon's tribes

  waveEvery => if @isHard() 3 else 4
  reinforceEvery => if @isHard() 4 else 3
  marchSteps => if @isHard() 3 else 2

  # Every few turns a warband leaves one of the camps still standing (they take turns) for the beach: two warriors
  # on normal, three on hard, and a raider with every third warband.
  sendWarbands {
    nextWave = @recall(KEY_NEXT_WAVE)
    if nextWave == null || Game.turn < nextWave {
      return
    }
    pyracmon = @tribes()
    waves = (@recall(KEY_WAVES) ?? 0) + 1
    @remember(KEY_WAVES, waves)
    @remember(KEY_NEXT_WAVE, Game.turn + @waveEvery())
    band = ["warrior", "warrior"]
    if @isHard() {
      band.add("warrior")
    }
    if waves % 3 == 0 {
      band.add("raider")
    }
    sent = false
    camps = @unitsIn(KEY_CAMPS)
    if !camps.isEmpty {
      camps = [camps.(waves % camps.size)]
    }
    for camp in camps {
      for typeId in band {
        spot = @freeCellNear(camp.coordinates)
        if spot != null {
          @addToSet(KEY_WARBANDS, spot.summon(typeId, pyracmon).id)
          sent = true
        }
      }
    }
    if sent {
      Game.refreshState()
      @queue(if waves == 1 "firstWarband" else "warband")
    }
  }

  # Warbands march by the script, not by sight: towards the nearest outsider in CHASE_RANGE, otherwise towards the
  # Colonial Hall (or the landing). Next to an outsider they stop; the tribes' own turn does the fighting.
  marchWarbands {
    for raider in @unitsIn(KEY_WARBANDS) {
      at = raider.coordinates
      if at != null && @nearestPlayerUnit(at, 1) == null {
        prey = @nearestPlayerUnit(at, CHASE_RANGE)
        goal = prey?.coordinates ?? @unitOf(@human(), "colonialHall")?.coordinates ?? Game.grid.startingLocations.0
        @trek(raider, goal, @marchSteps())
      }
    }
  }

  # ------------------------------------------------------------------ the navy

  # The flagship at anchor shells the tribesman nearest to death within reach of its guns.
  flagshipFires {
    flagship = @unitOf(Game.players.1, "ironclad")
    if flagship == null || flagship.coordinates == null {
      return
    }
    here = Game.grid.elementAt(flagship.coordinates)
    tribesId = @tribes().id
    inReach = Game.grid.allUnits.where(=> $0.owner.id == tribesId && $0.coordinates != null && !$0.isBuilding \
      && here.distance($0.coordinates) <= FLAGSHIP_REACH)
    if inReach.isEmpty {
      return
    }
    target = inReach.minBy(=> $0.hp)
    Game.animateAttack(flagship, target)
    Game.animateVisualFx([[type: "explosion", coordinates: target.coordinates]])
    target.takeDamage(if @isHard() 10 else 15, flagship)
  }

  # Every few turns the flagship's boats land riflemen on the beach (and, the second time, a settler).
  reinforce {
    count = @recall(KEY_REINFORCEMENTS) ?? 0
    if count >= MAX_REINFORCEMENTS || Game.turn < (@recall(KEY_NEXT_REINFORCEMENT) ?? 99) || @unitsIn(KEY_CAMPS).isEmpty {
      return
    }
    count += 1
    @remember(KEY_REINFORCEMENTS, count)
    @remember(KEY_NEXT_REINFORCEMENT, Game.turn + @reinforceEvery())
    player = @human()
    landing = @markerAt("landing")
    soldiers = if @isHard() 1 else 2
    for i in 0..soldiers {
      spot = @freeCellNear(landing)
      if spot != null {
        spot.summon("rifleman", player)
      }
    }
    if count == 2 {
      spot = @freeCellNear(landing)
      if spot != null {
        spot.summon("settler", player)
        @queue("settlerLanded")
      }
    } else {
      @queue("reinforcements")
    }
    Game.refreshState()
  }

  # ------------------------------------------------------------------ helpers

  t(key) => Game.localizedStr(key)
  # Cutscenes stop the turn timer; it starts again with the human's next action.
  pauseTimer => Server.setTimeoutEnabled(false)
  resumeTimer => Server.setTimeoutEnabledOnUserAction(true)
  human => Game.players.0
  tribes => Game.players.2
  isHard => Game.currentScenario.difficulty == "hard"

  # Whether the human won Calamity on the Horizon in this campaign (the tribe got away across the river).
  playedCalamity {
    campaign = Game.campaign
    # Landfall is unlocked only once chapter 1 is won and saved; before that, progressFor would create an empty entry
    if campaign == null || !("Landfall" in campaign.unlockedScenarios) {
      return false
    }
    return campaign.progressFor("CalamityOnTheHorizon")?.getExtraValue("survivors") != null
  }

  say(portrait, owner, titleKey, lineKey) {
    Game.showDialog(portrait, owner?.id, @t(titleKey), @t(lineKey))
  }
  captainSays(lineKey) => @say("rifleman", @human(), "lfSpeakerCaptain", lineKey)
  navySays(lineKey) => @say("ironclad", Game.players.1, "lfSpeakerNavy", lineKey)

  startObjective(objectiveId, keyBase, image, descriptionText) {
    objective = [
      id: objectiveId,
      title: @t(keyBase + "Title"),
      description: descriptionText ?? @t(keyBase + "Description"),
      image: image,
      state: ObjectiveStates.active
    ]
    Game.currentScenario.addObjective(objective)
    Game.refreshState()
  }
  complete(objectiveId) {
    Game.currentScenario.updateObjective(objectiveId, [state: ObjectiveStates.completed])
    Game.refreshState()
  }
  fail(objectiveId) {
    Game.currentScenario.updateObjective(objectiveId, [state: ObjectiveStates.failed])
    Game.refreshState()
  }
  isActive(objectiveId) => Game.currentScenario.objectiveState(objectiveId) == ObjectiveStates.active
  isDone(objectiveId) => Game.currentScenario.objectiveState(objectiveId) == ObjectiveStates.completed

  remember(key, value) {
    Game.currentScenario.addOrUpdateExtra(key, key, "", value)
  }
  recall(key) => Game.currentScenario.getExtraValue(key)
  queue(event) {
    pending = @recall(KEY_PENDING) ?? ""
    if !(("," + event + ",") in pending) {
      @remember(KEY_PENDING, (if pending == "" "," else pending) + event + ",")
    }
  }
  addToSet(key, unitId) {
    @remember(key, (@recall(key) ?? ",") + unitId + ",")
  }
  inSet(key, unitId) => ("," + unitId + ",") in (@recall(key) ?? "")
  unitsIn(key) {
    members = @recall(key) ?? ""
    return Game.grid.allUnits.where(=> $0.coordinates != null && ("," + $0.id + ",") in members)
  }

  marker(comment) => Game.grid.cells.first(=> $0.comment == comment)
  markerAt(comment) => @marker(comment).coordinates
  unitOf(player, typeId) => player.ownedUnits.first(=> $0.type.id == typeId && $0.coordinates != null)
  tribeUnits(typeId) {
    tribesId = @tribes().id
    return Game.grid.allUnits.where(=> $0.owner.id == tribesId && $0.type.id == typeId && $0.coordinates != null)
  }

  freeCellNear(center) {
    for radius in 1...3 {
      for candidate in Game.grid.ringAround(center, radius) {
        if candidate.content == null && !(candidate.terrain in WATER) {
          return candidate
        }
      }
    }
    return null
  }

  nearestPlayerUnit(origin, maxRange) {
    playerId = @human().id
    here = Game.grid.elementAt(origin)
    best = null
    bestDistance = maxRange + 1
    for candidate in Game.grid.allUnits.where(=> $0.owner.id == playerId && $0.coordinates != null) {
      candidateDistance = here.distance(candidate.coordinates)
      if candidateDistance < bestDistance {
        best = candidate
        bestDistance = candidateDistance
      }
    }
    return best
  }

  # Up to steps cells over land, each one closer to goal (whatever the terrain: the tribes know the jungle).
  trek(walker, goal, steps) {
    origin = walker.coordinates
    if origin == null || goal == null {
      return false
    }
    at = Game.grid.elementAt(origin)
    for i in 0..steps {
      nextCell = null
      nextDistance = at.distance(goal)
      for land in Game.grid.ringAround(at.coordinates, 1) {
        if land.content == null && !(land.terrain in WATER) && land.distance(goal) < nextDistance {
          nextCell = land
          nextDistance = land.distance(goal)
        }
      }
      if nextCell != null {
        at = nextCell
      }
    }
    if at.distance(origin) == 0 {
      return false
    }
    Server.move(origin, at.coordinates, 0)
    return true
  }

  flagshipSound => Game.playSound(@markerAt("anchorage"), "ironclad", SoundTypes.attack, true)
}
